{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "downloadModels": {
      "type": "boolean"
    },
    "requireImageDigests": {
      "type": "boolean"
    },
    "fullnameOverride": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$",
      "maxLength": 48
    },
    "ollama": {
      "type": "object",
      "required": [
        "image",
        "persistence",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "chatModel": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": ":cloud($|-)"
          }
        },
        "embeddingModel": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": ":cloud($|-)"
          }
        },
        "contextLength": {
          "type": "integer",
          "minimum": 4096
        },
        "keepAlive": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "whisper": {
      "type": "object",
      "required": [
        "image",
        "persistence",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "pullPolicy": {
              "enum": [
                "IfNotPresent",
                "Always",
                "Never"
              ]
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "minLength": 1
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "modelRepo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "modelRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "device": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "computeType": {
          "enum": [
            "int8",
            "float16",
            "float32",
            "int8_float16"
          ]
        },
        "cpuThreads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "denyEgress": {
          "type": "boolean"
        },
        "clientNamespace": {
          "type": "string",
          "minLength": 1
        },
        "clientRelease": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "denyEgress": {
                "const": true
              }
            },
            "required": [
              "denyEgress"
            ]
          },
          "then": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
