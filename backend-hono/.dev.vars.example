# backend-hono ローカル開発用の機密変数の雛形。
# コピーして `.dev.vars` を作成（.gitignore 済み）。wrangler dev が自動で読み込む。
# 非機密の変数（USE_S3_STORAGE / CORS 等）は wrangler.jsonc の "vars" に置く。

# SimpleJWT の署名鍵。**現行 Django の SECRET_KEY と一致させる**（HS256, PoC #03）。
# これが一致していないと、Django 発行の access_token を Worker が検証できない。
JWT_SECRET=""

# RAG チャット（埋め込み + 生成）のサーバー側キー。Django settings.OPENAI_API_KEY と同じもの。
# 未設定だと /api/chat/messages は Django と同じ設定エラー（400 / SSE LLM_CONFIGURATION_ERROR）を返す。
# OPENAI_API_KEY=""
#
# 埋め込みプロバイダは wrangler.jsonc の vars（EMBEDDING_PROVIDER / EMBEDDING_MODEL /
# OLLAMA_BASE_URL）。ローカル DB が Ollama 1024 次元なら ollama のまま。

# OAuth 発行者 URL（本番は公開 API オリジン）。wrangler.jsonc の vars でも可。
# MCP の WWW-Authenticate resource_metadata に使う（Django OAUTH2_PROVIDER_ISSUER_URL）。
# OAUTH2_PROVIDER_ISSUER_URL="http://localhost:8000"

# OIDC（Django OAUTH2_PROVIDER.OIDC_*）。有効化時は RS256 用 PEM を設定。
# 改行は実改行または \n。wrangler.jsonc の OIDC_ENABLED=true と併用。
# OIDC_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
