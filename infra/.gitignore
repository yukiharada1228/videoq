# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files (keep the example)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Backend config (contains the account-bearing bucket name; keep the example)
backend.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep the dependency lock file committed
!.terraform.lock.hcl
