{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "videoq-web-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // HTML must pass through the locale/SEO rewriter. Hashed assets need no code.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/_headers"], "fallthrough": false }],
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "development" },
  "env": {
    "preview": {
      "name": "videoq-web-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": { "ENVIRONMENT": "preview" }
    },
    "production": {
      "name": "videoq-web",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "videoq.jp", "custom_domain": true },
        { "pattern": "www.videoq.jp", "custom_domain": true }
      ],
      "vars": { "ENVIRONMENT": "production" }
    }
  }
}
