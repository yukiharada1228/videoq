# Local wrangler dev for docker compose (Hono API).
FROM node:22-bookworm-slim

# workerd の outbound HTTPS（OpenAI 等）はコンテナの CA 信頼ストアを使う。
# slim イメージにはデフォルトで入っていないため明示インストールする。
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/docs/package.json apps/docs/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/trpc/package.json packages/trpc/package.json
RUN npm ci --workspace @videoq/api \
  && cp package-lock.json node_modules/.videoq-package-lock

COPY apps/api apps/api
COPY packages/trpc packages/trpc

WORKDIR /workspace/apps/api
RUN chmod +x scripts/docker-dev.sh

EXPOSE 8787

CMD ["scripts/docker-dev.sh"]
