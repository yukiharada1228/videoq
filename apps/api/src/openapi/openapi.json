{
  "openapi": "3.0.3",
  "info": {
    "title": "VideoQ API",
    "version": "1.0.0",
    "description": "Hono Worker OpenAPI surface (Django Admin / DRF spectacular 置換)."
  },
  "paths": {
    "/api/auth/login/": {
      "post": {
        "summary": "Login",
        "tags": ["auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string", "format": "password" }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout/": {
      "post": { "summary": "Logout", "tags": ["auth"] }
    },
    "/api/auth/refresh/": {
      "post": { "summary": "Refresh access token", "tags": ["auth"] }
    },
    "/api/auth/signup/": {
      "post": {
        "summary": "Sign up",
        "tags": ["auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me/": {
      "get": { "summary": "Current user", "tags": ["auth"] },
      "delete": { "summary": "Delete account", "tags": ["auth"] }
    },
    "/api/videos/": {
      "get": {
        "summary": "List videos",
        "tags": ["videos"],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "ordering", "in": "query", "schema": { "type": "string" } },
          { "name": "tags", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer" } }
        ]
      },
      "post": {
        "summary": "Upload video (multipart, local storage)",
        "tags": ["videos"],
        "description": "USE_S3_STORAGE=false only. Production uses /api/videos/uploads/."
      }
    },
    "/api/videos/uploads/": {
      "post": {
        "summary": "Request signed upload URL",
        "tags": ["videos"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["filename", "content_type", "file_size", "title"],
                "properties": {
                  "filename": { "type": "string" },
                  "content_type": { "type": "string" },
                  "file_size": { "type": "integer" },
                  "title": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/api/videos/youtube/": {
      "post": {
        "summary": "Register YouTube video",
        "tags": ["videos"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["youtube_url", "title"],
                "properties": {
                  "youtube_url": { "type": "string", "format": "uri" },
                  "title": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/api/videos/{id}/": {
      "get": {
        "summary": "Video detail",
        "tags": ["videos"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ]
      },
      "patch": {
        "summary": "Update video / confirm upload",
        "tags": ["videos"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ]
      },
      "delete": {
        "summary": "Delete video",
        "tags": ["videos"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ]
      }
    },
    "/api/videos/groups/": {
      "get": { "summary": "List groups", "tags": ["videos"] },
      "post": {
        "summary": "Create group",
        "tags": ["videos"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/api/videos/tags/": {
      "get": { "summary": "List tags", "tags": ["videos"] },
      "post": {
        "summary": "Create tag",
        "tags": ["videos"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "color"],
                "properties": {
                  "name": { "type": "string" },
                  "color": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/messages/": {
      "post": {
        "summary": "Send chat message (non-stream)",
        "tags": ["chat"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message", "group_id"],
                "properties": {
                  "message": { "type": "string" },
                  "group_id": { "type": "integer" },
                  "mode": { "type": "string", "enum": ["qa", "study"] },
                  "language": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/messages/stream/": {
      "post": {
        "summary": "Send chat message (SSE)",
        "tags": ["chat"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message", "group_id"],
                "properties": {
                  "message": { "type": "string" },
                  "group_id": { "type": "integer" },
                  "mode": { "type": "string", "enum": ["qa", "study"] }
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/history/": {
      "get": { "summary": "Chat history", "tags": ["chat"] },
      "delete": { "summary": "Clear chat history", "tags": ["chat"] }
    },
    "/api/v1/chat/completions": {
      "post": {
        "summary": "OpenAI-compatible chat completions",
        "tags": ["openai"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "model": { "type": "string" },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": { "type": "string" },
                        "content": { "type": "string" }
                      }
                    }
                  },
                  "group_id": { "type": "integer" },
                  "temperature": { "type": "number" },
                  "max_tokens": { "type": "integer" },
                  "stream": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "/api/ops/users/": {
      "get": {
        "summary": "List users (ops / superuser)",
        "tags": ["ops"],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } }
        ]
      }
    },
    "/api/ops/embeddings/reindex-all/": {
      "post": {
        "summary": "Re-index all video embeddings (ops / superuser)",
        "tags": ["ops"]
      }
    }
  }
}
