/**
 * VideoQ backend on Cloudflare Workers (Hono).
 * Native API runtime:
 *   - Hono ルーター + 共通ミドルウェア（requestId / logger / CORS / error handler）
 *   - /health（liveness） /ready（DB 疎通）
 *   - Hyperdrive 経由の Neon 接続（per-request Client）
 *   - R2 バインディング
 *   - 未定義パスは統一された 404
 *
 * Deploy production: `npm run deploy` → `--env production`
 * Local: top-level vars + hyperdrive.localConnectionString / `.dev.vars`
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 本番は `env.production` の `backend-hono`。名前を分けておかないと
  // `--env production` を付け忘れた `wrangler deploy` が本番を上書きする。
  "name": "backend-hono-dev",
  // このトップレベル設定は `wrangler dev` 専用。`--env production` を付け忘れた
  // deploy が公開URLを持たないよう workers.dev を閉じる。ENVIRONMENT が
  // "development" のまま到達可能になると、テスト用認証ヘッダの経路が開く。
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "ENVIRONMENT": "development",
    "USE_S3_STORAGE": "true",
    "CORS_ALLOW_ORIGIN": "http://localhost,http://127.0.0.1,http://127.0.0.1:3000,http://localhost:3000",
    "FRONTEND_URL": "http://localhost",
    "DEFAULT_FROM_EMAIL": "noreply@videoq.local",
    "GROUP_INVITATION_BATCH_LIMIT": "50",
    "MAX_VIDEO_UPLOAD_SIZE_MB": "200",
    "DEFAULT_STORAGE_LIMIT_GB": "1",
    "DEFAULT_PROCESSING_LIMIT_MINUTES": "10",
    "DEFAULT_AI_ANSWERS_LIMIT": "15",
    "STRIPE_AUTOMATIC_TAX": "false",
    "EMBEDDING_PROVIDER": "ollama",
    "EMBEDDING_MODEL": "qwen3-embedding:0.6b",
    "EMBEDDING_VECTOR_SIZE": "1024",
    "OLLAMA_BASE_URL": "http://127.0.0.1:11434",
    "LLM_MODEL": "gpt-4o-mini",
    "PGVECTOR_COLLECTION_NAME": "scene_embeddings",
    "OAUTH_ISSUER_URL": "http://localhost",
    "BETTER_AUTH_URL": "http://localhost"
  },

  "send_email": [{ "name": "EMAIL" }],

  // `wrangler dev` は localConnectionString しか見ない。id に本番の Hyperdrive を
  // 書くと、`--env production` を付け忘れた deploy が本番DBに繋がってしまうため、
  // ここには存在しない id を置く。本番の id は env.production 側にだけ書く。
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@localhost:55432/postgres"
    }
  ],

  "r2_buckets": [
    {
      "binding": "VIDEO_BUCKET",
      "bucket_name": "videoq-media",
      "preview_bucket_name": "videoq-media-preview"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "STUDY_SESSION", "class_name": "StudySession" }
    ]
  },
  "migrations": [
    { "tag": "v1-rate-limiter", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2-study-session", "new_sqlite_classes": ["StudySession"] }
  ],

  "triggers": {
    "crons": ["*/5 * * * *", "17 3 * * *"]
  },

  "env": {
    "production": {
      "name": "backend-hono",
      // 公開経路は下の routes だけ。workers.dev を開けると CORS も
      // Cookie ドメインも効かない第二の入口ができてしまう。
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "production",
        "USE_S3_STORAGE": "true",
        "CORS_ALLOW_ORIGIN": "https://videoq.jp",
        "FRONTEND_URL": "https://videoq.jp",
        "DEFAULT_FROM_EMAIL": "noreply@mg.videoq.jp",
        "MAILGUN_SENDER_DOMAIN": "mg.videoq.jp",
        "GROUP_INVITATION_BATCH_LIMIT": "50",
        "MAX_VIDEO_UPLOAD_SIZE_MB": "200",
        "DEFAULT_STORAGE_LIMIT_GB": "1",
        "DEFAULT_PROCESSING_LIMIT_MINUTES": "10",
        "DEFAULT_AI_ANSWERS_LIMIT": "15",
        "STRIPE_AUTOMATIC_TAX": "false",
        "EMBEDDING_PROVIDER": "openai",
        "EMBEDDING_MODEL": "text-embedding-3-small",
        "EMBEDDING_VECTOR_SIZE": "1536",
        "OLLAMA_BASE_URL": "",
        "LLM_MODEL": "gpt-4o-mini",
        "PGVECTOR_COLLECTION_NAME": "scene_embeddings",
        "OAUTH_ISSUER_URL": "https://videoq.jp",
        "BETTER_AUTH_URL": "https://videoq.jp",
        "R2_BUCKET_NAME": "videoq-media-prod",
        "R2_S3_ENDPOINT": "https://12daec56fdba43f677f2766ee26a5a39.r2.cloudflarestorage.com",
        "R2_S3_REGION": "auto"
      },
      "routes": [
        { "pattern": "videoq.jp/api/*", "zone_name": "videoq.jp" },
        { "pattern": "videoq.jp/.well-known/*", "zone_name": "videoq.jp" },
        { "pattern": "videoq.jp/health", "zone_name": "videoq.jp" },
        { "pattern": "videoq.jp/ready", "zone_name": "videoq.jp" }
      ],
      "send_email": [{ "name": "EMAIL" }],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "d69ecb01a493415197e52552db2990f8"
        }
      ],
      "r2_buckets": [
        {
          "binding": "VIDEO_BUCKET",
          "bucket_name": "videoq-media-prod"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "STUDY_SESSION", "class_name": "StudySession" }
        ]
      },
      "triggers": {
        "crons": ["*/5 * * * *", "17 3 * * *"]
      }
    }
  }
}
