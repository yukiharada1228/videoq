{
  "name": "videoq-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example --check",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:generate:user-id-uuid": "tsx scripts/generate-user-id-uuid-migration.mjs",
    "db:migrate": "sh scripts/db-migrate.sh",
    "db:stamp": "node scripts/stamp-baseline.mjs",
    "db:studio": "drizzle-kit studio",
    "db:etl": "node --experimental-strip-types scripts/etl-copy-legacy.ts",
    "db:etl:verify": "node --experimental-strip-types scripts/etl-copy-legacy.ts --verify",
    "db:maintain": "sh scripts/maintain.sh",
    "db:cutover": "sh scripts/maintain.sh cutover",
    "db:legacy:rename": "sh scripts/maintain.sh rename",
    "db:legacy:drop": "sh scripts/maintain.sh drop",
    "user:password:local": "node scripts/reset-local-password.mjs",
    "user:superuser": "node scripts/create-superuser.mjs",
    "rate-limit:reset": "sh scripts/reset-rate-limit.sh"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.26",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@better-auth/oauth-provider": "^1.6.26",
    "@hono/mcp": "^0.3.1",
    "@hono/zod-openapi": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scalar/hono-api-reference": "^0.9.48",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.33",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260821.1",
    "@types/pg": "^8.20.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
