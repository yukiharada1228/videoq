{
  "name": "@videoq/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:workers",
    "test:unit": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example",
    "cf-typegen:check": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example --check",
    "cf:hyperdrive:show": "wrangler hyperdrive get d69ecb01a493415197e52552db2990f8",
    "cf:hyperdrive:disable-cache": "wrangler hyperdrive update d69ecb01a493415197e52552db2990f8 --caching-disabled",
    "cf:r2-cors:apply": "wrangler r2 bucket cors set videoq-media-prod --file r2-cors.production.json --force",
    "cf:r2-cors:list": "wrangler r2 bucket cors list videoq-media-prod",
    "db:check": "drizzle-kit check",
    "db:verify": "node scripts/check-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "sh scripts/db-migrate.sh",
    "db:stamp": "node scripts/stamp-baseline.mjs",
    "db:studio": "drizzle-kit studio",
    "db:etl": "node --experimental-strip-types scripts/etl-copy-legacy.ts",
    "db:etl:verify": "node --experimental-strip-types scripts/etl-copy-legacy.ts --verify",
    "db:maintain": "sh scripts/maintain.sh",
    "db:cutover": "sh scripts/maintain.sh cutover",
    "db:legacy:rename": "sh scripts/maintain.sh rename",
    "db:legacy:drop": "sh scripts/maintain.sh drop",
    "user:password:local": "node scripts/reset-local-password.mjs",
    "user:admin": "node scripts/create-admin.mjs",
    "rate-limit:reset": "sh scripts/reset-rate-limit.sh",
    "embeddings:check": "tsx scripts/check-embeddings.ts",
    "demo:prepare": "tsx scripts/prepare-landing-demo.ts",
    "demo:students": "tsx scripts/prepare-student-demo.ts",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node dist/node.mjs",
    "dev:node": "tsx src/runtime/node.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.11",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/oauth-provider": "^1.7.11",
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.5",
    "@hono/trpc-server": "^0.4.2",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@trpc/server": "^11.19.0",
    "@videoq/trpc": "0.1.0",
    "@yukiharada1228/langchain-postgres": "^0.1.2",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "langchain": "^1.5.16",
    "langsmith": "0.10.13",
    "openai": "^7.34.0",
    "pg": "^8.23.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@typescript/typescript-linux-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  }
}
